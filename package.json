{
  "name": "dsh-workbuddy-project",
  "version": "0.4.0-preview.1",
  "description": "DSH 项目交付：多仓库项目、可复用工作流、节点能力和运行验收",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "examples",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "scripts"
  ],
  "engines": {
    "node": ">=22.15.0",
    "dsh": "~0.2.1-rc.2"
  },
  "license": "MIT",
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": "~0.2.1-rc.2",
    "@deepseek-ai/dsh-mcp-client": "~0.2.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "~0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@modelcontextprotocol/client": "^2.0.0",
    "@deepseek-ai/dsh-app-boot": "~0.2.1-rc.2",
    "@deepseek-ai/dsh-agent": "~0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "~0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "~0.2.1-rc.2"
  },
  "scripts": {
    "test": "node test/packages.mjs && node test/library-sync.mjs",
    "test:host": "node test/packages-host.mjs",
    "test:ui": "node test/packages-ui.cjs",
    "test:preset": "node test/preset-host.mjs",
    "check:package": "node scripts/check-package.mjs",
    "test:delivery": "node test/delivery/check-store.mjs && node test/delivery/check-code-handoff.mjs && node test/delivery/check-quality-ledger.mjs && node test/delivery/check-run-checkpoints.mjs"
  },
  "dependencies": {
    "yaml": "2.9.1",
    "ajv": "8.20.0",
    "cron-parser": "4.9.0",
    "quickjs-emscripten": "0.32.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "projects",
    "workbuddy",
    "skills",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matiomlei/dsh-workbuddy-project.git"
  },
  "homepage": "https://github.com/matiomlei/dsh-workbuddy-project#readme",
  "bugs": {
    "url": "https://github.com/matiomlei/dsh-workbuddy-project/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "jsdom": "^26.1.0"
  }
}
